{
  "manifest_version": 3,
  "name": "FalconMM Inbox",
  "version": "0.4.0",
  "minimum_chrome_version": "111",
  "description": "把当前页图片/视频、B 站/抖音/小红书原生下载与脚本下载送进本机 FalconMM 素材库 Inbox；只走本机通道，不上传任何远端。",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "抓取到 FalconMM Inbox",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/toolbar-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
